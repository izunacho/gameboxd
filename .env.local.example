# ======================
# SUPABASE CONFIGURATION
# ======================
# Get these from https://supabase.com
# In your project dashboard: Settings → API → Project Configuration

# Your Supabase project URL (looks like: https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous API key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (SECRET - never expose in frontend or GitHub!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ======================
# IGDB API CONFIGURATION (via Twitch Developer)
# ======================
# ⚠️ CRITICAL: Never expose CLIENT_SECRET in frontend!
# These are server-side only - used in Next.js API Routes
# Get from: https://dev.twitch.tv/console/apps

# Your Twitch Application Client ID
IGDB_CLIENT_ID=your-twitch-client-id-here

# Your Twitch Application Client Secret (KEEP PRIVATE!)
IGDB_CLIENT_SECRET=your-twitch-client-secret-here

# ======================
# WEB PUSH (VAPID) CONFIGURATION
# ======================
# Generate a key pair with: npx web-push generate-vapid-keys
# The public key is safe to expose; the private key is server-only.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Contact for push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:you@example.com

# Shared secret between the Supabase Database Webhook and /api/push/notify.
# Any long random string, e.g.: openssl rand -hex 24
PUSH_WEBHOOK_SECRET=your-random-secret

# ======================
# PATREON CONFIGURATION
# ======================
# From your Patreon Creator client: patreon.com/portal/registration/register-clients

PATREON_CLIENT_ID=your-patreon-client-id
PATREON_CLIENT_SECRET=your-patreon-client-secret

# Your campaign's numeric id
PATREON_CAMPAIGN_ID=your-campaign-id

# Comma-separated tier ids that grant premium. Leave empty to let any active
# pledge qualify.
PATREON_QUALIFYING_TIER_IDS=

# Signs the OAuth "connect" state — generate your own, e.g.: openssl rand -hex 32
PATREON_STATE_SECRET=your-random-secret

# From the webhook you create in the Patreon portal (Webhooks section),
# pointed at /api/patreon/webhook with the members:pledge:* triggers enabled.
PATREON_WEBHOOK_SECRET=your-webhook-secret

# ======================
# APPLICATION CONFIGURATION
# ======================
# Base URL of your application

NEXT_PUBLIC_APP_URL=http://localhost:3000
